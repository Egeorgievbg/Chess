# Application environment: development, testing, or production
APP_ENV=development

# Generate a unique value for every deployment.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Local development database. Production must use PostgreSQL.
DATABASE_URL=sqlite:///instance/chess.db

# Comma-separated origins allowed to open Socket.IO connections.
SOCKETIO_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Development server only
HOST=127.0.0.1
PORT=5000
